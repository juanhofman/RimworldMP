<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimworldMP.Tests.DeterminismHarness</RootNamespace>
    <AssemblyName>RimworldMP.Tests.DeterminismHarness</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Directory.Build.props disables this for mod assemblies; tests need it. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RimworldMP.API\RimworldMP.API.csproj" />
    <ProjectReference Include="..\..\src\RimworldMP.Core\RimworldMP.Core.csproj" />
    <ProjectReference Include="..\..\src\RimworldMP.Net\RimworldMP.Net.csproj" />
    <ProjectReference Include="..\..\src\RimworldMP.Compat\RimworldMP.Compat.csproj" />
    <!-- Lobby presentation + MpLobbyActions (builds under RIMWORLDMP_NO_GAME_REFS). -->
    <ProjectReference Include="..\..\src\RimworldMP\RimworldMP.csproj" />
    <ProjectReference Include="..\..\examples\CompatHello\CompatHello.csproj" />
    <ProjectReference Include="..\..\examples\CompatHostIo\CompatHostIo.csproj" />
  </ItemGroup>
  <!-- Compile launcher ModlistHasher (no Avalonia/UI) so CI can assert byte-identical Core mirror. -->
  <ItemGroup>
    <Compile Include="..\..\tools\RimworldMP.Launcher\Services\ModlistHasher.cs" Link="LauncherMirror\ModlistHasher.cs" />
    <Compile Include="..\..\tools\RimworldMP.Launcher\Services\LauncherPaths.cs" Link="LauncherMirror\LauncherPaths.cs" />
  </ItemGroup>
</Project>
