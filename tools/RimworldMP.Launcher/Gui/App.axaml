<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RimworldMP.Launcher.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RimworldMP.Launcher/Gui/Styles/Theme.axaml" />
  </Application.Styles>
  <Application.Resources>
    <FontFamily x:Key="FontBrand">avares://RimworldMP.Launcher/Assets/Fonts/Syne-Bold.ttf#Syne</FontFamily>
    <FontFamily x:Key="FontDisplay">avares://RimworldMP.Launcher/Assets/Fonts/SpaceGrotesk-Bold.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontDisplayMedium">avares://RimworldMP.Launcher/Assets/Fonts/SpaceGrotesk-Medium.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontBody">avares://RimworldMP.Launcher/Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontBodyMedium">avares://RimworldMP.Launcher/Assets/Fonts/IBMPlexSans-Medium.ttf#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontBodySemi">avares://RimworldMP.Launcher/Assets/Fonts/IBMPlexSans-SemiBold.ttf#IBM Plex Sans</FontFamily>

    <Color x:Key="Ink">#0E1114</Color>
    <Color x:Key="InkElevated">#151A1F</Color>
    <Color x:Key="InkLine">#24303A</Color>
    <Color x:Key="Steel">#7EB0C8</Color>
    <Color x:Key="SteelDim">#5A8498</Color>
    <Color x:Key="Ember">#E07A3D</Color>
    <Color x:Key="EmberHot">#F08A4D</Color>
    <Color x:Key="Fog">#C5D0D8</Color>
    <Color x:Key="FogMuted">#8A96A0</Color>
    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="BrushInkElevated" Color="{StaticResource InkElevated}" />
    <SolidColorBrush x:Key="BrushInkLine" Color="{StaticResource InkLine}" />
    <SolidColorBrush x:Key="BrushSteel" Color="{StaticResource Steel}" />
    <SolidColorBrush x:Key="BrushSteelDim" Color="{StaticResource SteelDim}" />
    <SolidColorBrush x:Key="BrushEmber" Color="{StaticResource Ember}" />
    <SolidColorBrush x:Key="BrushFog" Color="{StaticResource Fog}" />
    <SolidColorBrush x:Key="BrushFogMuted" Color="{StaticResource FogMuted}" />
  </Application.Resources>
</Application>
