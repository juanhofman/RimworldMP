<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RimworldMP.Launcher.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RimworldMP.Launcher/Gui/Styles/Theme.axaml" />
  </Application.Styles>
  <Application.Resources>
    <FontFamily x:Key="FontBrand">avares://RimworldMP.Launcher/Assets/Fonts/Cinzel-Bold.ttf#Cinzel</FontFamily>
    <FontFamily x:Key="FontBrandSemi">avares://RimworldMP.Launcher/Assets/Fonts/Cinzel-SemiBold.ttf#Cinzel</FontFamily>
    <FontFamily x:Key="FontDisplay">avares://RimworldMP.Launcher/Assets/Fonts/BarlowCondensed-Bold.ttf#Barlow Condensed</FontFamily>
    <FontFamily x:Key="FontDisplaySemi">avares://RimworldMP.Launcher/Assets/Fonts/BarlowCondensed-SemiBold.ttf#Barlow Condensed</FontFamily>
    <FontFamily x:Key="FontBody">avares://RimworldMP.Launcher/Assets/Fonts/SourceSans3-Regular.ttf#Source Sans 3</FontFamily>
    <FontFamily x:Key="FontBodyMedium">avares://RimworldMP.Launcher/Assets/Fonts/SourceSans3-Medium.ttf#Source Sans 3</FontFamily>
    <FontFamily x:Key="FontBodySemi">avares://RimworldMP.Launcher/Assets/Fonts/SourceSans3-SemiBold.ttf#Source Sans 3</FontFamily>

    <!-- Wood / parchment palette (vanilla RW menu feel) -->
    <Color x:Key="WoodDeep">#1C1410</Color>
    <Color x:Key="WoodPanel">#2B2118</Color>
    <Color x:Key="WoodEdge">#4A3828</Color>
    <Color x:Key="BorderHard">#5C4330</Color>
    <Color x:Key="Parchment">#E4D5B5</Color>
    <Color x:Key="ParchmentDeep">#D6C4A0</Color>
    <Color x:Key="InkBrown">#2A1C12</Color>
    <Color x:Key="Cream">#F2E6C9</Color>
    <Color x:Key="GoldMuted">#C4A574</Color>
    <Color x:Key="Amber">#C97828</Color>
    <Color x:Key="AmberHot">#D98935</Color>
    <Color x:Key="AmberEdge">#8B5A1E</Color>
    <Color x:Key="WarnEmber">#B85A28</Color>

    <SolidColorBrush x:Key="BrushWoodDeep" Color="{StaticResource WoodDeep}" />
    <SolidColorBrush x:Key="BrushWoodPanel" Color="{StaticResource WoodPanel}" />
    <SolidColorBrush x:Key="BrushWoodEdge" Color="{StaticResource WoodEdge}" />
    <SolidColorBrush x:Key="BrushBorderHard" Color="{StaticResource BorderHard}" />
    <SolidColorBrush x:Key="BrushParchment" Color="{StaticResource Parchment}" />
    <SolidColorBrush x:Key="BrushParchmentDeep" Color="{StaticResource ParchmentDeep}" />
    <SolidColorBrush x:Key="BrushInkBrown" Color="{StaticResource InkBrown}" />
    <SolidColorBrush x:Key="BrushCream" Color="{StaticResource Cream}" />
    <SolidColorBrush x:Key="BrushGoldMuted" Color="{StaticResource GoldMuted}" />
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="BrushAmberHot" Color="{StaticResource AmberHot}" />
    <SolidColorBrush x:Key="BrushAmberEdge" Color="{StaticResource AmberEdge}" />
    <SolidColorBrush x:Key="BrushWarnEmber" Color="{StaticResource WarnEmber}" />
  </Application.Resources>
</Application>
