<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimworldMP.Launcher.ViewModels"
        xmlns:models="using:RimworldMP.Launcher.Models"
        x:Class="RimworldMP.Launcher.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RimworldMP"
        Width="1080" Height="680"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="False">

  <Window.Styles>
    <Style Selector="Border.atmosphere">
      <Setter Property="Opacity" Value="0" />
      <Style.Animations>
        <Animation Duration="0:0:0.55" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- Atmosphere: ink + steel radial + faint grid -->
    <Panel IsHitTestVisible="False">
      <Panel.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#0E1114" Offset="0" />
          <GradientStop Color="#12181E" Offset="0.55" />
          <GradientStop Color="#0B0E11" Offset="1" />
        </LinearGradientBrush>
      </Panel.Background>
      <Ellipse Width="720" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-120,-180,0" Opacity="0.22">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#7EB0C8" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="480" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-160,0,0,-140" Opacity="0.12">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#E07A3D" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <!-- Faint topographic-ish grid -->
      <Canvas Opacity="0.07">
        <Canvas.Background>
          <VisualBrush TileMode="Tile" DestinationRect="0,0,48,48">
            <VisualBrush.Visual>
              <Border Width="48" Height="48" BorderBrush="#7EB0C8" BorderThickness="0,0,1,1" Background="Transparent" />
            </VisualBrush.Visual>
          </VisualBrush>
        </Canvas.Background>
      </Canvas>
    </Panel>

    <Grid ColumnDefinitions="200,*" Margin="0">
      <!-- Side nav -->
      <Border Grid.Column="0" Background="#0A0C0F" BorderBrush="#1C252E" BorderThickness="0,0,1,0" Padding="20,28,16,24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,28">
            <TextBlock Classes="brand" Text="RimworldMP" FontSize="22" />
            <TextBlock Classes="muted" Text="LAN launcher" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="6">
            <TextBlock Classes="muted" Text="{Binding StatusLine}" TextWrapping="Wrap" FontSize="11" LineHeight="16" />
          </StackPanel>

          <StackPanel Spacing="4">
            <Button Classes="nav" Classes.active="{Binding IsHome}" Content="Home" Command="{Binding GoHomeCommand}" />
            <Button Classes="nav" Classes.active="{Binding IsHost}" Content="Host" Command="{Binding GoHostCommand}" />
            <Button Classes="nav" Classes.active="{Binding IsJoin}" Content="Join" Command="{Binding GoJoinCommand}" />
            <Button Classes="nav" Classes.active="{Binding IsMods}" Content="Mods" Command="{Binding GoModsCommand}" />
            <Button Classes="nav" Classes.active="{Binding IsLaunch}" Content="Launch" Command="{Binding GoLaunchCommand}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Pages -->
      <Border Grid.Column="1" Classes="atmosphere" Padding="48,40,48,36">
        <Panel>
          <!-- HOME -->
          <Grid IsVisible="{Binding IsHome}">
            <StackPanel VerticalAlignment="Center" MaxWidth="640" Spacing="18">
              <TextBlock Classes="brand" Text="RimworldMP" FontSize="64" LineHeight="68" />
              <TextBlock Classes="display" Text="Shared colony. Same tick." FontSize="26"
                         Foreground="#C5D0D8" Opacity="0.92" />
              <TextBlock Classes="muted" FontSize="15" LineHeight="22" MaxWidth="480" TextWrapping="Wrap"
                         Text="Pin Harmony → RimworldMP, find a LAN host, hand off into RimWorld 1.7. Local only — nothing leaves your network." />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Button Classes="cta" Content="Host a session" Command="{Binding GoHostCommand}" />
                <Button Classes="ghost" Content="Join LAN" Command="{Binding GoJoinCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- HOST -->
          <Grid IsVisible="{Binding IsHost}" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,28">
              <TextBlock Classes="display" Text="Host" FontSize="32" />
              <TextBlock Classes="muted" Text="Advertise on LAN, write handoff, start RimWorld." FontSize="14" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
              <StackPanel Spacing="6">
                <TextBlock Classes="steel" Text="SESSION NAME" FontSize="11" />
                <TextBox Classes="field" Text="{Binding SessionName}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Classes="steel" Text="GAME PORT" FontSize="11" />
                  <TextBox Classes="field" Text="{Binding HostPort}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="steel" Text="ADVERTISE IP" FontSize="11" />
                  <TextBox Classes="field" Text="{Binding BindHost}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="steel" Text="MAX CLIENTS" FontSize="11" />
                <NumericUpDown Value="{Binding MaxClients}" Minimum="1" Maximum="16" FormatString="0"
                               Background="#12171C" BorderBrush="#24303A" Foreground="#C5D0D8" Width="120" HorizontalAlignment="Left" />
              </StackPanel>
              <CheckBox IsChecked="{Binding PrepareModsOnLaunch}" Content="Prepare mods (Harmony first + backup)" />
              <CheckBox IsChecked="{Binding LaunchGame}" Content="Launch RimWorld after handoff" />

              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Border Classes="live-dot" IsVisible="{Binding IsHosting}" VerticalAlignment="Center">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.9" />
                    </Transitions>
                  </Border.Transitions>
                  <Border.Styles>
                    <Style Selector="Border.live-dot">
                      <Style.Animations>
                        <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate">
                          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Border.Styles>
                </Border>
                <TextBlock Classes="steel" Text="{Binding HostStatus}" VerticalAlignment="Center" FontSize="13" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
              <Button Classes="cta" Command="{Binding StartHostCommand}">
                <Panel>
                  <TextBlock Text="Start hosting" IsVisible="{Binding !IsHosting}" />
                  <TextBlock Text="Stop beacon" IsVisible="{Binding IsHosting}" />
                </Panel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- JOIN -->
          <Grid IsVisible="{Binding IsJoin}" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
              <TextBlock Classes="display" Text="Join" FontSize="32" />
              <TextBlock Classes="muted" Text="Discover a LAN host or enter an IP." FontSize="14" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
              <Button Classes="ghost" Content="Scan LAN" Command="{Binding DiscoverCommand}" IsEnabled="{Binding !IsDiscovering}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="12"
                         Text="Scanning…" IsVisible="{Binding IsDiscovering}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
              <ItemsControl ItemsSource="{Binding DiscoveredHosts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DiscoveryBeacon">
                    <Border Classes="row" Margin="0,0,0,8"
                            PointerPressed="OnBeaconPressed"
                            Tag="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock FontFamily="{DynamicResource FontBodySemi}" FontSize="14" Text="{Binding Name}" />
                          <TextBlock Classes="muted" FontSize="12"
                                     Text="{Binding Host, StringFormat='{}{0}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                          <TextBlock Classes="steel" FontSize="12" Text="{Binding ModHashShort, StringFormat='hash {0}…'}" />
                          <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Right"
                                     Text="{Binding Port, StringFormat=':{0}'}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,12,120">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Classes="steel" Text="HOST IP" FontSize="11" />
                  <TextBox Classes="field" Text="{Binding JoinIp}" Watermark="192.168.x.x" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="steel" Text="PORT" FontSize="11" />
                  <TextBox Classes="field" Text="{Binding JoinPort}" />
                </StackPanel>
              </Grid>
              <CheckBox IsChecked="{Binding PrepareModsOnLaunch}" Content="Prepare mods before join" />
              <CheckBox IsChecked="{Binding LaunchGame}" Content="Launch RimWorld after handoff" />
              <Button Classes="cta" Content="Join session" Command="{Binding JoinSelectedCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>

          <!-- MODS (list + hash + Harmony-first + LAN sync hooks) -->
          <Grid IsVisible="{Binding IsMods}" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
              <TextBlock Classes="display" Text="Mods" FontSize="32" />
              <TextBlock Classes="muted" Text="Harmony first, then official, RimworldMP, then the rest. Sync from host when the LAN backend is registered." FontSize="14" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
              <TextBlock Classes="steel" FontSize="11" Text="MODLIST HASH" />
              <TextBlock FontFamily="{DynamicResource FontBodyMedium}" FontSize="13" Text="{Binding ModlistHash}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding ModsConfigPath}" TextWrapping="Wrap" />
              <TextBlock FontSize="12" Foreground="#E07A3D" Text="{Binding ModsWarning}"
                         TextWrapping="Wrap" IsVisible="{Binding ModsWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="cta" Content="Prepare for MP" Command="{Binding PrepareModsCommand}" />
                <Button Classes="ghost" Content="Restore backup" Command="{Binding RestoreModsCommand}" />
                <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshModsSnapshotCommand}" />
              </StackPanel>

              <!-- LAN sync hook panel — fills via IModSyncClient -->
              <Border Margin="0,10,0,0" Padding="14,12" Background="#12171C" BorderBrush="#24303A" BorderThickness="1" CornerRadius="2">
                <StackPanel Spacing="10">
                  <TextBlock Classes="steel" FontSize="11" Text="SYNC FROM HOST (LAN)" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding SyncStatusMessage}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,10,100,10,Auto">
                    <TextBox Classes="field" Text="{Binding SyncHost}" Watermark="Host IP" />
                    <TextBox Grid.Column="2" Classes="field" Text="{Binding SyncPort}" Watermark="30557" />
                    <Button Grid.Column="4" Classes="ghost" Content="Use Join IP" Command="{Binding UseJoinTargetForSyncCommand}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="Compare" Command="{Binding CompareWithHostCommand}" IsEnabled="{Binding !IsSyncing}" />
                    <Button Classes="cta" Content="Sync from host" Command="{Binding SyncFromHostCommand}" IsEnabled="{Binding !IsSyncing}" />
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}" />
                  </StackPanel>
                  <Grid IsVisible="{Binding IsSyncing}" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding SyncProgressFraction}" Height="6"
                                 Foreground="#E07A3D" Background="#24303A" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding SyncProgressLabel}" />
                  </Grid>
                  <Grid IsVisible="{Binding HasSyncDeltas}" ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Classes="steel" FontSize="11" Text="MISSING" />
                      <ItemsControl ItemsSource="{Binding SyncMissing}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ModSyncDeltaRow">
                            <TextBlock FontSize="12" Foreground="#E07A3D" Margin="0,2" Text="{Binding PackageId}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="steel" FontSize="11" Text="MISMATCHED" />
                      <ItemsControl ItemsSource="{Binding SyncMismatched}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ModSyncDeltaRow">
                            <TextBlock FontSize="12" Foreground="#7EB0C8" Margin="0,2" Text="{Binding PackageId}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#12171C" BorderBrush="#24303A" BorderThickness="1" CornerRadius="2" Padding="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ModRows}" Margin="16,12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModListRow">
                      <Grid ColumnDefinitions="36,*,Auto" Margin="0,5">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Index}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontBody}" FontSize="13"
                                   Foreground="#C5D0D8" Text="{Binding PackageId}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="steel" FontSize="11" Text="{Binding Badge}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- LAUNCH / STATUS -->
          <Grid IsVisible="{Binding IsLaunch}" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
              <TextBlock Classes="display" Text="Launch" FontSize="32" />
              <TextBlock Classes="muted" Text="RimWorld install and session status." FontSize="14" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="12" MaxWidth="640" Margin="0,0,0,20">
              <StackPanel Spacing="6">
                <TextBlock Classes="steel" Text="INSTALL PATH" FontSize="11" />
                <Grid ColumnDefinitions="*,10,Auto">
                  <TextBox Classes="field" Text="{Binding InstallPath}" Watermark="/path/to/RimWorld" />
                  <Button Grid.Column="2" Classes="ghost" Content="Locate" Command="{Binding RefreshInstallCommand}" />
                </Grid>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding InstallSummary}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding LastHandoffPath, StringFormat='Handoff: {0}'}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2" Background="#12171C" BorderBrush="#24303A" BorderThickness="1" CornerRadius="2" Padding="18,14">
              <TextBlock Text="{Binding LaunchLog}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                         FontFamily="{DynamicResource FontBody}" Foreground="#C5D0D8" />
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
              <Button Classes="cta" Content="Host" Command="{Binding GoHostCommand}" />
              <Button Classes="ghost" Content="Join" Command="{Binding GoJoinCommand}" />
              <Button Classes="ghost" Content="Stop beacon" Command="{Binding StopHostCommand}" IsVisible="{Binding IsHosting}" />
            </StackPanel>
          </Grid>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</Window>
