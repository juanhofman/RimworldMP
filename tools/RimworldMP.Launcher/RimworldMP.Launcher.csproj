<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RimworldMP.Launcher</RootNamespace>
    <AssemblyName>RimworldMP.Launcher</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Avalonia needs ICU; do not force invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avoid inheriting repo Directory.Build.props GenerateDependencyFile=false quirks when nested. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Gui\Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimworldMP.ModSync\RimworldMP.ModSync.csproj" />
  </ItemGroup>

  <!-- Linux/macOS: Exe so console CLI fallback still works. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) or $([MSBuild]::IsOSPlatform('OSX'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

</Project>
